# Local development settings for acme-api. Copy to .env and adjust.
# Values below match the workshop VDI defaults from bin/setup-environment.sh.
# Never put real AWS/Aurora credentials in this file.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_NAME=acme_db
POSTGRES_USER=postgres
POSTGRES_PASS=postgres123

# Local-only signing key (generate a real one with: python scripts/generate_jwt_secret.py)
JWT_SECRET_KEY=local-dev-only-jwt-secret-change-me-0123456789

# Password given to every seeded demo account (python scripts/seed.py); dev data only
SEED_DEMO_PASSWORD=DemoPass123!
